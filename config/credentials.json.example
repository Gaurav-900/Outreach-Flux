{
  "installed": {
    "client_id": "YOUR_CLIENT_ID",
    "project_id": "YOUR_PROJECT_ID",
    "auth_uri": "https://accounts.google.com/o/oauth2/auth",
    "token_uri": "https://oauth2.googleapis.com/token",
    "auth_provider_x509_cert_url": "https://www.googleapis.com/oauth2/v1/certs",
    "client_secret": "YOUR_CLIENT_SECRET",
    "redirect_uris": ["http://localhost"]
  }
}

/* 
INSTRUCTIONS TO GET CREDENTIALS.JSON:
1. Go to Google Cloud Console (https://console.cloud.google.com/)
2. Create a new project or select an existing one.
3. Enable the "Gmail API" in API & Services.
4. Configure the "OAuth consent screen" (Desktop app type, add your own email as a test user if External).
5. Go to Credentials -> Create Credentials -> OAuth client ID.
6. Application type: "Desktop app".
7. Click "Download JSON" and save the file as `config/credentials.json`.
8. The first time the script runs, it will open your browser to log in and create `token.json` automatically.
*/
